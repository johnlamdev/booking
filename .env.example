# 複製為 .env.local 後填入實際值。切勿把填好的檔案提交進版控。

# --- 資料庫 ---
# Runtime 連線。使用 Supabase transaction pooler（port 6543）。
# postgres.js 在此模式下必須設 prepare: false（已在 src/server/db 處理）。
DATABASE_URL=

# Migration 專用連線。使用 direct connection 或 session pooler（port 5432）。
DIRECT_DATABASE_URL=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
# Anon key 會進 client bundle。所有資料表為 deny-all RLS，故此 key 讀不到任何業務資料。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 應用程式 ---
# 用於產生學生的查詢狀態連結，必須與實際執行的位址一致。
# 本機開發固定使用 3100（見 package.json 的 dev script），避免與其他專案搶 3000。
NEXT_PUBLIC_APP_URL=http://localhost:3100

# production 公開 endpoint 限流所信任的 client IP header。
# 必須填部署平台會覆寫、外部請求不能自行控制的 header 名稱。
# 請根據自己的部署平台設定，並確認外部請求不能自行控制該 header。
# 未設定時 production 會讓所有來源共用同一個限流 bucket（安全地 fail closed）。
RATE_LIMIT_IP_HEADER=

# --- 公開 Beta ---
# 公開註冊與重設密碼預設開啟；明確填 false 才會關閉。
# INVITE_TESTING_MODE 預設關閉；只有私有邀請環境才設 true。
# Demo 帳號由管理員另外建立，不會因這些設定而污染正式帳號。
# 對外開放前，先為 Supabase Auth 設定自己的 SMTP 服務。
PUBLIC_SIGNUP_ENABLED=true
PASSWORD_RESET_ENABLED=true
INVITE_TESTING_MODE=false

# --- 可選：受邀體驗帳號（一般公開安裝不用填） ---
# 僅供本機管理員腳本使用，不要放進公開網站的部署環境。
SUPABASE_SERVICE_ROLE_KEY=
# 測試 workspace 內所有 WhatsApp 操作的實際收件號碼（可含 + 號及空格）。
# 未設定時會安全地停用 WhatsApp 開啟按鈕，不會傳到示範學生號碼。
TEST_WHATSAPP_OVERRIDE_NUMBER=
# 建立單一 demo 老師時暫時填入，必須與正式老師使用不同電郵。
TEST_TEACHER_EMAIL=
TEST_TEACHER_PASSWORD=

# --- 測試 ---
# 完整 Playwright 流程使用的預置老師帳號與已發佈 workspace。
# 三項齊全才會執行 full-booking-flow.spec.ts；否則只跑公開頁 smoke tests。
E2E_TEST_TEACHER_EMAIL=
E2E_TEST_TEACHER_PASSWORD=
E2E_TEST_WORKSPACE_SLUG=
# 整合測試用的 Docker Postgres 連線，例如
# postgres://postgres:postgres@localhost:54329/booking_test
TEST_DATABASE_URL=
